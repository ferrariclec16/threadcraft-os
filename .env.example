# ==============================================================================
# ThreadCraft OS - Environment Configuration
# ==============================================================================
# Copy this file to .env.local for local development, or set these variables
# in Vercel / Railway / Supabase for production deployment.

# ------------------------------------------------------------------------------
# 1. DATABASE (Supabase / Neon / PostgreSQL)
# ------------------------------------------------------------------------------
# In demo mode, if this is not set, ThreadCraft OS automatically runs on its
# zero-config in-memory & localStorage client-side sync engine.
# When you provide a DATABASE_URL, Prisma will automatically persist to your DB.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# ------------------------------------------------------------------------------
# 2. AI GENERATION & HOOK ENGINE (OpenAI / Anthropic / Gemini)
# ------------------------------------------------------------------------------
# ThreadCraft includes an intelligent heuristic fallback engine so it works
# even without an API key! Adding your key enables live LLM-powered deep generation.
OPENAI_API_KEY="sk-proj-..."
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (Optional: NextAuth / Supabase Auth)
# ------------------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-32-char-secret-string-here"

# ------------------------------------------------------------------------------
# 4. SUBSCRIPTION & BILLING (Stripe / LemonSqueezy)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID="price_..."
NEXT_PUBLIC_STRIPE_AGENCY_PRICE_ID="price_..."

# ------------------------------------------------------------------------------
# 5. APP METADATA
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ThreadCraft OS"
